COUNTRIES = {}  # code -> (continent, name)
for line in COUNTRY_TABLE.strip().splitlines():
    code, cont, name = line.split(" ", 2)
    COUNTRIES[code.lower()] = (cont, name)


def sortkey(name):
    """Sortiert Ä wie A usw."""
    return unicodedata.normalize("NFD", name).encode("ascii", "ignore").decode().lower()


def whiptail(*args):
    """Startet whiptail; gibt (ok, Auswahl) zurück."""
    r = subprocess.run(["whiptail", "--title", TITLE, *args], stderr=subprocess.PIPE, text=True)
    return r.returncode == 0, r.stderr.strip()


def msg(text, h=12, w=70):
    whiptail("--msgbox", text, str(h), str(w))


def read_conf():
    with open(CONF) as f:
        text = f.read()
    vals = dict(re.findall(r'^(\w+)="([^"]*)"', text, re.M))
    return text, vals


def write_conf(key, value):
    text, _ = read_conf()
    new = re.sub(rf'^{key}="[^"]*"', f'{key}="{value}"', text, count=1, flags=re.M)
    if new == text and f'{key}="{value}"' not in text:
        new = f'{key}="{value}"\n' + text
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.replace(tmp, CONF)


def allowed():
    return set(read_conf()[1].get("COUNTRIES", "").split())


def enabled():
    return read_conf()[1].get("ENABLED", "no") == "yes"


def table_loaded():
    return subprocess.run(["nft", "list", "chain", "inet", "geowarden", "prerouting"],
                          capture_output=True).returncode == 0


def blocked_count():
    r = subprocess.run(["nft", "list", "counter", "inet", "geowarden", "blocked"],
                       capture_output=True, text=True)
    m = re.search(r"packets (\d+)", r.stdout)
    return m.group(1) if m else "-"


def wan_ifaces():
    """Gefilterte Interfaces: WAN_IF aus der Konfiguration, sonst die der Default-Routen."""
    conf = read_conf()[1].get("WAN_IF", "").split()
    if conf:
        return conf
    found = []
    for fam in ("-4", "-6"):
        out = subprocess.run(["ip", fam, "-o", "route", "show", "default"],
                             capture_output=True, text=True).stdout
        found += re.findall(r"\bdev (\S+)", out)
    return sorted(set(found))


def ssh_warning():
    """Warnt, wenn die eigene SSH-Verbindung über das öffentliche Interface käme und nicht erlaubt ist."""
    client = os.environ.get("SSH_CLIENT", "").split(" ")[0]
    if not client or not table_loaded():
        return ""
    route = subprocess.run(["ip", "route", "get", client], capture_output=True, text=True).stdout
    if not any(f"dev {w} " in route for w in wan_ifaces()):
        return ""
    setname = "allow6" if ":" in client else "allow4"
    r = subprocess.run(["nft", "get", "element", "inet", "geowarden", setname, f"{{ {client} }}"],
                       capture_output=True)
    if r.returncode != 0:
        return (f"\n\nACHTUNG: Deine SSH-Adresse {client} ist nicht erlaubt. Die laufende "
                "Verbindung bleibt bestehen, eine neue wird blockiert!")
    return ""


def apply():
    whiptail("--infobox", "Regeln werden angewendet ...", "7", "50")
    r = subprocess.run([APPLY], capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        msg(f"Fehler beim Anwenden, die alten Regeln bleiben aktiv:\n\n{out}", 14, 76)
    else:
        msg(out + ssh_warning(), 12, 76)


def set_countries(codes):
    if not codes and enabled():
        ok, _ = whiptail("--defaultno", "--yesno",
                         "Kein Land mehr erlaubt: Der Server wäre dann (außer Port 80 und "
                         "Tailscale) von überall gesperrt.\n\nTrotzdem speichern?", "11", "70")
        if not ok:
            return
    write_conf("COUNTRIES", " ".join(sorted(codes)))
    if enabled():
        apply()


def show_status():
    a = allowed()
    per = "\n".join(
        f"  {name:<34} {sum(1 for c in a if COUNTRIES.get(c, ('',))[0] == key):>3} von "
        f"{sum(1 for v in COUNTRIES.values() if v[0] == key)}"
        for key, name in CONTINENTS)
    cache = sorted(f for f in os.listdir("/var/cache/geowarden")
                   if f.startswith("dbip-")) if os.path.isdir("/var/cache/geowarden") else []
    msg(f"Sperre (Konfiguration): {'AN' if enabled() else 'AUS'}\n"
        f"Regeln geladen:         {'ja' if table_loaded() else 'nein'}\n"
        f"Blockiert seit Laden:   {blocked_count()} Pakete\n"
        f"Geodaten:               {cache[-1] if cache else '-'}\n"
        f"Gefilterte Interfaces:  {' '.join(wan_ifaces()) or '-'}\n\n"
        f"Erlaubte Länder: {len(a)}\n{per}", 20, 66)


def show_allowed():
    a = allowed()
    lines = []
    for key, cname in CONTINENTS:
        names = sorted((COUNTRIES[c][1] for c in a if COUNTRIES.get(c, ("",))[0] == key), key=sortkey)
        if names:
            lines.append(f"{cname}:\n  " + ", ".join(names))
    unknown = sorted(c.upper() for c in a if c not in COUNTRIES)
    if unknown:
        lines.append("Unbekannte Codes: " + ", ".join(unknown))
    msg("\n\n".join(lines) or "Kein Land erlaubt.", 22, 76)


def toggle_enabled():
    if enabled():
        ok, _ = whiptail("--defaultno", "--yesno",
                         "Sperre ausschalten? Danach ist der Server wieder aus allen Ländern erreichbar.",
                         "9", "64")
        if ok:
            write_conf("ENABLED", "no")
            apply()
    else:
        write_conf("ENABLED", "yes")
        apply()


def edit_continent(key, cname):
    codes = sorted((c for c, v in COUNTRIES.items() if v[0] == key), key=lambda c: sortkey(COUNTRIES[c][1]))
    a = allowed()
    ok, choice = whiptail("--menu", cname, "13", "60", "3",
                          "1", "Länder einzeln auswählen",
                          "2", "Alle erlauben",
                          "3", "Alle sperren")
    if not ok:
        return
    if choice == "2":
        set_countries(a | set(codes))
    elif choice == "3":
        set_countries(a - set(codes))
    else:
        items = []
        for c in codes:
            items += [c.upper(), COUNTRIES[c][1], "ON" if c in a else "OFF"]
        ok, sel = whiptail("--separate-output", "--checklist",
                           f"{cname}: Leertaste = an/aus, Enter = speichern",
                           "22", "64", "14", *items)
        if not ok:
            return
        chosen = {s.lower() for s in sel.split()}
        new = (a - set(codes)) | chosen
        if new != a:
            set_countries(new)


def edit_countries():
    while True:
        a = allowed()
        items = []
        for key, cname in CONTINENTS:
            total = sum(1 for v in COUNTRIES.values() if v[0] == key)
            n = sum(1 for c in a if COUNTRIES.get(c, ("",))[0] == key)
            items += [key, f"{cname}  ({n}/{total} erlaubt)"]
        ok, choice = whiptail("--cancel-button", "Zurück", "--menu",
                              "Kontinent wählen:", "16", "64", str(len(CONTINENTS)), *items)
        if not ok:
            return
        edit_continent(choice, dict(CONTINENTS)[choice])


def main():
    if os.geteuid() != 0:
        sys.exit("geowarden muss als root laufen.")
    if len(sys.argv) > 1:
        sys.exit("Aufruf ohne Argumente: geowarden")
    while True:
        state = "AN" if enabled() else "AUS"
        ok, choice = whiptail("--cancel-button", "Beenden", "--menu",
                              f"Sperre ist {state} - {len(allowed())} Länder erlaubt", "15", "60", "5",
                              "1", "Status anzeigen",
                              "2", "Sperre ausschalten" if state == "AN" else "Sperre einschalten",
                              "3", "Länder bearbeiten (nach Kontinent)",
                              "4", "Erlaubte Länder anzeigen")
        if not ok:
            return
        {"1": show_status, "2": toggle_enabled, "3": edit_countries, "4": show_allowed}[choice]()


if __name__ == "__main__":
    main()
