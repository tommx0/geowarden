def sortkey(name):
    """Sorts Å like A etc.: NFD splits "Å" into "A" plus a combining ring, and the
    ASCII encoding then drops the ring."""
    return unicodedata.normalize("NFD", name).encode("ascii", "ignore").decode().lower()


def backtitle():
    """Shown on top of every dialog: version, copyright, license and project page."""
    # Still a placeholder when run from the source tree instead of the built package
    version = "" if VERSION.startswith("@") else f" {VERSION}"
    year = "" if YEAR.startswith("@") else f" {YEAR}"
    return f"geowarden{version} | (c){year} Thomas Marx | MIT | {URL.split('//')[1]}"


def whiptail(*args):
    """Runs whiptail; returns (ok, selection).

    ok is False for Cancel/Back/Esc. whiptail draws on the terminal (stdout) and writes
    the chosen menu tag or checklist items to stderr, which is why stderr is captured."""
    r = subprocess.run(["whiptail", "--backtitle", backtitle(), "--title", TITLE, *args],
                       stderr=subprocess.PIPE, text=True)
    return r.returncode == 0, r.stderr.strip()


def msg(text, h=12, w=70):
    """Message box with an OK button, h lines high and w columns wide."""
    whiptail("--msgbox", text, str(h), str(w))


# --- Configuration ------------------------------------------------------------
# The config is read fresh on every access, so the menu always shows what is in the
# file, also after it was edited by hand.

def read_conf():
    """Returns the raw text and a dict of all KEY="value" lines."""
    with open(CONF) as f:
        text = f.read()
    vals = dict(re.findall(r'^(\w+)="([^"]*)"', text, re.M))
    return text, vals


def write_conf(key, value):
    """Sets KEY="value" and keeps all other lines and comments as they are."""
    text, _ = read_conf()
    new = re.sub(rf'^{key}="[^"]*"', f'{key}="{value}"', text, count=1, flags=re.M)
    # Key not in the file yet (older configuration): add it at the end
    if new == text and f'{key}="{value}"' not in text:
        new = text.rstrip("\n") + f'\n\n{key}="{value}"\n'
    # Write a temporary file and rename it, so the config is never half written
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.replace(tmp, CONF)


def parse_nets(values):
    """The valid networks among BLOCK_NETS entries. Invalid ones are left out here;
    geowarden-apply refuses them with a message."""
    nets = []
    for v in values:
        try:
            nets.append(ipaddress.ip_network(v, strict=False))
        except ValueError:
            pass
    return nets


def blocked_nets():
    """Networks from BLOCK_NETS."""
    return parse_nets(read_conf()[1].get("BLOCK_NETS", "").split())


def in_networks(addr, nets):
    """True if the address (or the first address of a network) is in one of the networks."""
    ip = ipaddress.ip_address(addr.split("/")[0])
    return any(ip.version == n.version and ip in n for n in nets)


def net_of(addr, prefix=None):
    """The network of an address with the given prefix length, by default the smallest
    scanner level (/24 or /48). IPv4 by bit mask, because the live view calls this often."""
    version = 6 if ":" in addr else 4
    prefix = prefix or SCANNER_LEVELS[version][0][0]
    if version == 4:
        mask = (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF
        n = int.from_bytes(socket.inet_aton(addr), "big") & mask
        return f"{socket.inet_ntoa(n.to_bytes(4, 'big'))}/{prefix}"
    return str(ipaddress.ip_network(f"{addr}/{prefix}", strict=False))


def addresses_per_net(addrs):
    """{network: number of different addresses} at every scanner level."""
    counts = {}
    for addr in set(addrs):
        for prefix, _ in SCANNER_LEVELS[6 if ":" in addr else 4]:
            net = net_of(addr, prefix)
            counts[net] = counts.get(net, 0) + 1
    return counts


def suspect_net(addr, per_net):
    """The smallest network of the address that counts as suspicious, or None."""
    for prefix, minimum in SCANNER_LEVELS[6 if ":" in addr else 4]:
        net = net_of(addr, prefix)
        if per_net.get(net, 0) >= minimum:
            return net
    return None


def address_hint(addr, nets, per_net):
    """"listed" if the address is in a blocked network, "scanner?" if one of its networks
    sent requests from many different addresses, else ""."""
    if in_networks(addr, nets):
        return "listed"
    return "scanner?" if suspect_net(addr, per_net) else ""


def allowed():
    """Set of the allowed country codes (lower case) from the config."""
    return set(read_conf()[1].get("COUNTRIES", "").split())


def enabled():
    """True if blocking is turned on in the config (not necessarily loaded yet)."""
    return read_conf()[1].get("ENABLED", "no") == "yes"


# --- nftables state -----------------------------------------------------------

def table_loaded():
    """True if the filter chain is loaded in the kernel."""
    return subprocess.run(["nft", "list", "chain", "inet", "geowarden", "prerouting"],
                          capture_output=True).returncode == 0


def counter(name):
    """Packets of the named counter ("allowed" or "blocked"), 0 if it doesn't exist."""
    r = subprocess.run(["nft", "list", "counter", "inet", "geowarden", name],
                       capture_output=True, text=True)
    m = re.search(r"packets (\d+)", r.stdout)
    return int(m.group(1)) if m else 0


def wan_ifaces():
    """Filtered interfaces: WAN_IF from the config, otherwise those of the default routes."""
    conf = read_conf()[1].get("WAN_IF", "").split()
    if conf:
        return conf
    found = []
    for fam in ("-4", "-6"):
        out = subprocess.run(["ip", fam, "-o", "route", "show", "default"],
                             capture_output=True, text=True).stdout
        found += re.findall(r"\bdev (\S+)", out)
    return sorted(set(found))


def filtered_ssh_client():
    """Address of our own SSH client if its connection comes in via a filtered interface,
    otherwise "" (not logged in via SSH, or e.g. via Tailscale or the LAN)."""
    # SSH_CLIENT is "client-ip client-port server-port"; empty when not logged in via SSH
    client = os.environ.get("SSH_CLIENT", "").split(" ")[0]
    if not client:
        return ""
    # Replies to the client leave through the interface it came in on. If that is not a
    # filtered one, the rules don't apply to this connection.
    route = subprocess.run(["ip", "route", "get", client], capture_output=True, text=True).stdout
    return client if any(f"dev {w} " in route for w in wan_ifaces()) else ""


def ssh_warning():
    """Warns if our own SSH connection comes in via a public interface and is not allowed."""
    client = filtered_ssh_client()
    if not client or not table_loaded():
        return ""
    if in_networks(client, blocked_nets()):
        return (f"\n\nWARNING: Your SSH address {client} is in a blocked network. The current "
                "connection stays open, but a new one will be blocked!")
    # "nft get element" fails if the address is in none of the ranges of the allow set
    setname = "allow6" if ":" in client else "allow4"
    r = subprocess.run(["nft", "get", "element", "inet", "geowarden", setname, f"{{ {client} }}"],
                       capture_output=True)
    if r.returncode != 0:
        return (f"\n\nWARNING: Your SSH address {client} is not allowed. The current "
                "connection stays open, but a new one will be blocked!")
    return ""


# --- Menu actions -------------------------------------------------------------

def apply():
    """Runs geowarden-apply and shows its output. On failure the script leaves the
    loaded rules unchanged, so the message says so."""
    whiptail("--infobox", "Applying rules ...", "7", "50")
    r = subprocess.run([APPLY], capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        msg(f"Applying failed, the previous rules stay active:\n\n{out}", 14, 76)
    else:
        msg(out + ssh_warning(), 12, 76)


def set_countries(codes):
    """Saves the new set of allowed countries and applies it right away if blocking is on.
    An empty set needs a confirmation, because it would block every country."""
    if not codes and enabled():
        ok, _ = whiptail("--defaultno", "--yesno",
                         "No country allowed: the server would then be blocked from everywhere "
                         "(except port 80 and Tailscale).\n\nSave anyway?", "11", "70")
        if not ok:
            return
    write_conf("COUNTRIES", " ".join(sorted(codes)))
    if enabled():
        apply()


def set_blocked_nets(nets):
    """Saves BLOCK_NETS and applies it if blocking is on."""
    write_conf("BLOCK_NETS", " ".join(nets))
    if enabled():
        apply()
    else:
        msg("Saved. The blocked networks take effect when blocking is turned on.", 8, 64)


def add_blocked_net(suggest=""):
    """Asks for a network or address (suggest is filled in) and adds it to BLOCK_NETS."""
    ok, value = whiptail("--inputbox",
                         "Network or address to block, for example\n"
                         "109.196.32.0/21, 203.0.113.7 or 2001:db8::/32", "10", "64", suggest)
    value = value.strip()
    if not ok or not value:
        return
    try:
        net = ipaddress.ip_network(value, strict=False)  # 109.196.36.1/21 -> 109.196.32.0/21
    except ValueError:
        msg(f"{value!r} is not a network or address.", 8, 60)
        return
    current = read_conf()[1].get("BLOCK_NETS", "").split()
    if any(net.version == n.version and net.subnet_of(n) for n in blocked_nets()):
        msg(f"{net} is already blocked.", 8, 60)
        return
    client = filtered_ssh_client()
    if client and in_networks(client, [net]):
        ok, _ = whiptail("--defaultno", "--yesno",
                         f"WARNING: Your own SSH address {client} is in {net}. The current "
                         "connection stays open, but new SSH connections from it will be "
                         "blocked.\n\nBlock it anyway?", "11", "68")
        if not ok:
            return
    # Very large networks are more likely a typo than intended
    if net.prefixlen < (16 if net.version == 4 else 32):
        ok, _ = whiptail("--defaultno", "--yesno",
                         f"{net} has {net.num_addresses:,} addresses.\n\nBlock all of them?", "10", "68")
        if not ok:
            return
    # Entries inside the new network are no longer needed
    keep = [v for v in current
            if not any(n.version == net.version and n.subnet_of(net) for n in parse_nets([v]))]
    set_blocked_nets(keep + [str(net)])


def edit_blocked_nets():
    """Blocked networks: list, add, remove, and whether they may still use the open ports."""
    while True:
        conf = read_conf()[1]
        nets = conf.get("BLOCK_NETS", "").split()
        on_ports = conf.get("BLOCK_NETS_OPEN_PORTS", "yes") == "yes"
        open_ports = ([f"tcp/{p}" for p in conf.get("OPEN_TCP", "").split()]
                      + [f"udp/{p}" for p in conf.get("OPEN_UDP", "").split()])
        items = ["a", "Add a network or address",
                 "p", f"Open ports ({' '.join(open_ports) or 'none'}): "
                      f"{'blocked too' if on_ports else 'still open to them'}"]
        for i, v in enumerate(nets, 1):
            items += [str(i), f"{v:<40} {country_name(country_of(v.split('/')[0]))[:20]}"]
        ok, choice = whiptail("--cancel-button", "Back", "--menu",
                              "Requests from these networks are dropped, whatever their country. "
                              "Existing connections stay open. Choose an entry to remove it.",
                              str(min(22, 12 + len(nets))), "76", str(min(12, 2 + len(nets))), *items)
        if not ok:
            return
        if choice == "a":
            add_blocked_net()
        elif choice == "p":
            ok, _ = whiptail(*(["--defaultno"] if not on_ports else []), "--yesno",
                             "Should blocked networks also be blocked on the open ports "
                             f"({' '.join(open_ports) or 'none'})?\n\n"
                             "Yes: they cannot reach anything (recommended for scanners).\n"
                             "No: the open ports stay open to them, e.g. for tcp/80 and the "
                             "Let's Encrypt HTTP-01 challenge.",
                             "13", "70")
            write_conf("BLOCK_NETS_OPEN_PORTS", "yes" if ok else "no")
            if enabled():
                apply()
        else:
            v = nets[int(choice) - 1]
            ok, _ = whiptail("--yesno", f"Remove {v} from the blocked networks?", "8", "64")
            if ok:
                set_blocked_nets([n for n in nets if n != v])


def show_status():
    """Overview: config vs. loaded state, request totals, geo data and allowed countries."""
    a = allowed()
    # One line per continent: "<name>   n of total"
    per = "\n".join(
        f"  {name:<38} {sum(1 for c in a if COUNTRIES.get(c, ('',))[0] == key):>3} of "
        f"{sum(1 for v in COUNTRIES.values() if v[0] == key)}"
        for key, name in CONTINENTS)
    cache = geo_files()
    since = stats_since()
    msg(f"Blocking (config):     {'ON' if enabled() else 'OFF'}\n"
        f"Rules loaded:          {'yes' if table_loaded() else 'no'}\n"
        f"Statistics since:      {format_time(since) if since else '-'}\n"
        f"Requests:              {counter('allowed'):,} allowed, {counter('blocked'):,} blocked\n"
        f"Geo data:              {cache[-1] if cache else '-'}\n"
        f"Filtered interfaces:   {' '.join(wan_ifaces()) or '-'}\n"
        f"Blocked networks:      {len(blocked_nets())}\n\n"
        f"Allowed countries: {len(a)}\n{per}", 22, 66)


def show_allowed():
    """Lists the allowed countries by name, grouped by continent. Codes from the config
    that are not in COUNTRY_TABLE (e.g. typos) are listed separately."""
    a = allowed()
    lines = []
    for key, cname in CONTINENTS:
        names = sorted((COUNTRIES[c][1] for c in a if COUNTRIES.get(c, ("",))[0] == key), key=sortkey)
        if names:
            lines.append(f"{cname}:\n  " + ", ".join(names))
    unknown = sorted(c.upper() for c in a if c not in COUNTRIES)
    if unknown:
        lines.append("Unknown codes: " + ", ".join(unknown))
    msg("\n\n".join(lines) or "No country allowed.", 22, 76)


def toggle_enabled():
    """Turns blocking on or off (off asks first) and applies it."""
    if enabled():
        ok, _ = whiptail("--defaultno", "--yesno",
                         "Turn blocking off? The server will then be reachable from all countries again.",
                         "9", "64")
        if ok:
            write_conf("ENABLED", "no")
            apply()
    else:
        write_conf("ENABLED", "yes")
        apply()


def edit_continent(key, cname):
    """Allow or block all countries of one continent, or pick them in a checklist."""
    # Countries of this continent, sorted by name
    codes = sorted((c for c, v in COUNTRIES.items() if v[0] == key), key=lambda c: sortkey(COUNTRIES[c][1]))
    a = allowed()
    ok, choice = whiptail("--menu", cname, "13", "60", "3",
                          "1", "Select countries individually",
                          "2", "Allow all",
                          "3", "Block all")
    if not ok:
        return
    if choice == "2":
        set_countries(a | set(codes))
    elif choice == "3":
        set_countries(a - set(codes))
    else:
        # Checklist items are triples: tag, description, initial state
        items = []
        for c in codes:
            items += [c.upper(), COUNTRIES[c][1], "ON" if c in a else "OFF"]
        ok, sel = whiptail("--separate-output", "--checklist",
                           f"{cname}: Space = on/off, Enter = save",
                           "22", "64", "14", *items)
        if not ok:
            return
        # --separate-output prints one checked tag per line
        chosen = {s.lower() for s in sel.split()}
        # Replace only this continent's part, keep the countries of the others
        new = (a - set(codes)) | chosen
        if new != a:
            set_countries(new)


def edit_countries():
    """Continent menu with "n/total allowed" per continent; loops until Back."""
    while True:
        a = allowed()
        items = []
        for key, cname in CONTINENTS:
            total = sum(1 for v in COUNTRIES.values() if v[0] == key)
            n = sum(1 for c in a if COUNTRIES.get(c, ("",))[0] == key)
            items += [key, f"{cname}  ({n}/{total} allowed)"]
        ok, choice = whiptail("--cancel-button", "Back", "--menu",
                              "Choose a continent:", "16", "64", str(len(CONTINENTS)), *items)
        if not ok:
            return
        edit_continent(choice, dict(CONTINENTS)[choice])


# --- Statistics ---------------------------------------------------------------
# The rules count every request that reaches the country check, per source address
# (IPv6 per /64) in the sets STAT_SETS, plus the totals in the counters "allowed"
# and "blocked". A request is a packet that opens a new connection, so a client
# that retries a blocked connection is counted once per attempt.

def geo_files():
    """Cached DB-IP files, oldest first; normally just one (dbip-YYYY-MM.csv.gz)."""
    return sorted(f for f in os.listdir(CACHE) if f.startswith("dbip-")) if os.path.isdir(CACHE) else []


def format_time(t):
    """Unix time as "YYYY-MM-DD HH:MM (… ago)"."""
    mins = int(time.time() - t) // 60
    if mins < 60:
        ago = f"{mins} min"
    elif mins < 48 * 60:
        ago = f"{mins // 60} h {mins % 60} min"
    else:
        ago = f"{mins // 1440} days {mins % 1440 // 60} h"
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) + f" ({ago} ago)"


def stats_since():
    """Start time of the statistics, None while no statistics are collected."""
    try:
        with open(STATS_SINCE) as f:
            since = int(f.read().strip())
    except (OSError, ValueError):
        return None
    # The file alone is not enough: the sets are gone when blocking is off or STATS_MAX is 0
    r = subprocess.run(["nft", "list", "set", "inet", "geowarden", STAT_SETS[-1]], capture_output=True)
    return since if r.returncode == 0 else None


def address_hits(setname):
    """{address: requests} from one of the statistics sets."""
    r = subprocess.run(["nft", "-j", "list", "set", "inet", "geowarden", setname],
                       capture_output=True, text=True)
    hits = {}
    if r.returncode == 0:
        # JSON output: {"nftables": [..., {"set": {..., "elem": [...]}}]}. An element with a
        # counter looks like {"elem": {"val": addr, "counter": {"packets": n, ...}}}; a
        # bare address string (no counter) is normalized to the same shape.
        for obj in json.loads(r.stdout)["nftables"]:
            for e in obj.get("set", {}).get("elem", []):
                e = e.get("elem", e) if isinstance(e, dict) else {"val": e}
                hits[e["val"]] = e.get("counter", {}).get("packets", 0)
    return hits


# Lookup table built from the DB-IP file on first use and kept while the menu runs:
# file = name of the loaded file, ranges = {4/6: CSV lines "start,end,CC"},
# starts = {4/6: start addresses as integers, same order, for binary search}
_geo = {}


def country_of(addr):
    """Country code (lower case) of an address from the cached DB-IP file, "zz" if unknown."""
    files = geo_files()
    if not files:
        return "zz"
    # (Re)load if not loaded yet or a newer file was downloaded meanwhile. The file is
    # sorted by start address, IPv4 first, so each list is already in ascending order.
    if _geo.get("file") != files[-1]:
        ranges = {4: [], 6: []}
        with gzip.open(os.path.join(CACHE, files[-1]), "rt") as f:
            for line in f.read().splitlines():
                ranges[6 if ":" in line[:line.find(",")] else 4].append(line)
        starts = {v: [ip_int(l[:l.find(",")]) for l in lines] for v, lines in ranges.items()}
        _geo.update(file=files[-1], ranges=ranges, starts=starts)
    n = ip_int(addr)
    version = 6 if ":" in addr else 4
    # Last range that starts at or before the address; it matches if it also ends after it
    i = bisect.bisect_right(_geo["starts"][version], n) - 1
    if i >= 0:
        _, end, cc = _geo["ranges"][version][i].split(",")
        if ip_int(end) >= n:
            return cc.lower()
    return "zz"


def ip_int(addr):
    """IPv4 or IPv6 address as integer, so addresses can be compared and searched."""
    family = socket.AF_INET6 if ":" in addr else socket.AF_INET
    return int.from_bytes(socket.inet_pton(family, addr), "big")


def collect_stats():
    """Requests per country {cc: [allowed, blocked]} and per address {"allow"/"block": [(n, addr, cc)]}."""
    whiptail("--infobox", "Loading statistics ...", "7", "50")
    countries, addrs = {}, {"allow": [], "block": []}
    for kind in addrs:
        for fam in (4, 6):
            for addr, n in address_hits(f"stat_{kind}{fam}").items():
                cc = country_of(addr)
                # Index 0 = allowed, 1 = blocked (True counts as 1)
                countries.setdefault(cc, [0, 0])[kind == "block"] += n
                addrs[kind].append((n, addr, cc))
    return countries, addrs


def country_name(cc):
    """Display name of a code; the upper-case code if not in COUNTRY_TABLE, "Unknown" for zz."""
    return COUNTRIES.get(cc, ("", "Unknown" if cc == "zz" else cc.upper()))[1]


def fg(color):
    """ANSI escape for a foreground color of the 256-color palette."""
    return f"\033[38;5;{color}m"


def show_screen(lines, prompt="Press Enter to go back "):
    """Shows colored text on the plain terminal; returns what was typed before Enter."""
    # whiptail can't show colors, so the map and the lists bypass it:
    # \033[H moves the cursor home, \033[2J clears the screen
    sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n\n  " + prompt)
    sys.stdout.flush()
    try:
        return input()
    except (EOFError, KeyboardInterrupt):
        return ""


def untracked_note(countries):
    """Note about requests that are only in the totals because an address list was full."""
    # The totals count every request; a full set no longer adds new addresses
    missing = counter("allowed") + counter("blocked") - sum(sum(v) for v in countries.values())
    if missing <= 0:
        return []
    return [f"  {missing:,} requests are only in the totals: an address list is full (STATS_MAX)"]


def header(title, since):
    """First lines of every statistics screen: title, start time, colored totals."""
    return ["", f"  {BOLD}{title}{RESET}",
            f"  Since {format_time(since)}",
            f"  Requests: {fg(GREEN[2])}{counter('allowed'):,} allowed{RESET}, "
            f"{fg(RED[2])}{counter('blocked'):,} blocked{RESET}", ""]


def map_colors(countries, allow):
    """Color per country: red/green by the kind of requests, brighter = more requests."""
    top = max((sum(v) for v in countries.values()), default=0)
    colors = {}
    for cc in set(COUNTRIES) | set(countries):
        a, b = countries.get(cc, (0, 0))
        if a + b:
            # Logarithmic scale: otherwise one busy country would make all others look
            # alike. share is 1.0 for the busiest country, levels pick the shade.
            share = math.log1p(a + b) / math.log1p(top)
            level = 2 if share > 0.8 else 1 if share > 0.55 else 0
            # Red if most requests from there were blocked, green otherwise
            colors[cc] = (RED if b >= a else GREEN)[level]
        else:
            colors[cc] = QUIET_ALLOWED if cc in allow else QUIET_BLOCKED
    return colors


def render_map(countries, colors, width, height):
    """Scales the world map to width x height pixels, two pixels per character (half blocks)."""
    # Source grid: each line of the file is a row of two-letter cells, ".." = sea
    with open(WORLDMAP) as f:
        grid = [[r[i:i + 2].lower() for i in range(0, len(r) - 1, 2)]
                for r in f.read().splitlines() if not r.startswith("#")]
    sh, sw = len(grid), len(grid[0])
    traffic = lambda cc: sum(countries.get(cc, (0, 0)))
    # pix[y][x] = country code of a target pixel, None = sea
    pix = [[None] * width for _ in range(height)]
    for y in range(height):
        # Source rows/columns [y0, y1) x [x0, x1) that fall into this pixel (at least one)
        y0 = y * sh // height
        y1 = max(y0 + 1, (y + 1) * sh // height)
        for x in range(width):
            x0 = x * sw // width
            x1 = max(x0 + 1, (x + 1) * sw // width)
            cells = [grid[j][i] for j in range(y0, y1) for i in range(x0, x1)]
            land = [c for c in cells if c != ".."]
            # Land if at least a third of the area is land, so coasts don't vanish
            if len(land) * 3 >= len(cells):
                # Prefer the country with the most requests, else the one covering most
                # cells (sorted first, so ties always pick the same country)
                busy = [c for c in land if traffic(c)]
                pix[y][x] = max(busy, key=traffic) if busy else max(sorted(set(land)), key=land.count)
    # Countries with requests stay visible even when they are smaller than a pixel
    shown = {c for row in pix for c in row}
    for j, row in enumerate(grid):
        for i, cc in enumerate(row):
            if cc != ".." and cc not in shown and traffic(cc):
                pix[j * height // sh][i * width // sw] = cc
                shown.add(cc)

    # Each character cell shows two pixel rows: the upper pixel as foreground of "▀",
    # the lower one as background. Escape codes are only written when the style changes,
    # which keeps the output small enough to draw quickly.
    lines = []
    for y in range(0, height - 1, 2):
        out, last = [], None
        for top, bottom in zip(pix[y], pix[y + 1]):
            t = colors.get(top, QUIET_BLOCKED) if top else None
            b = colors.get(bottom, QUIET_BLOCKED) if bottom else None
            if t is None and b is None:      # both sea
                style, ch = RESET, " "
            elif b is None or t == b:        # only the top is land, or both the same color
                style, ch = RESET + fg(t), "█" if t == b else "▀"
            elif t is None:                  # only the bottom is land
                style, ch = RESET + fg(b), "▄"
            else:                            # two different colors
                style, ch = fg(t) + f"\033[48;5;{b}m", "▀"
            if style != last:
                out.append(style)
                last = style
            out.append(ch)
        lines.append("".join(out) + RESET)
    return lines


def show_map(since):
    """Colored world map of the requests per country, sized to fit the terminal."""
    countries, _ = collect_stats()
    cols, rows = shutil.get_terminal_size()
    # At most the source resolution (200x78 cells), keeping its aspect ratio. The height
    # is in pixels and must be even (two per character). 11 lines are header and legend.
    width = min(cols - 4, 200)
    height = round(width * 78 / 200) // 2 * 2
    if height // 2 > rows - 11:
        height = (rows - 11) * 2
        width = round(height * 200 / 78)
    if width < 40 or height < 10:
        msg(f"The terminal is too small for the map ({cols}x{rows}). It needs at least 44x16.", 8, 60)
        return
    pad = " " * ((cols - width) // 2)  # center the map
    lines = header("Requests by country", since)
    lines += [pad + l for l in render_map(countries, map_colors(countries, allowed()), width, height)]
    # Legend: the three shades of a palette as blocks
    shade = lambda pal: "".join(fg(c) + "█" for c in pal) + RESET
    lines += ["", f"  {shade(RED)} blocked requests   {shade(GREEN)} allowed requests   (darker = fewer)",
              f"  {fg(QUIET_ALLOWED)}█{RESET} allowed country, no requests   "
              f"{fg(QUIET_BLOCKED)}█{RESET} blocked country, no requests"]
    show_screen(lines + untracked_note(countries))


def all_hits():
    """{(kind, address): requests} from the four statistics sets."""
    return {(kind, addr): n
            for kind in ("allow", "block") for fam in (4, 6)
            for addr, n in address_hits(f"stat_{kind}{fam}").items()}


def live_size():
    """Map width, height (pixels) and left padding for the live view, None if too small.
    Below the map there are LIVE_EVENTS + 6 lines of text."""
    cols, rows = shutil.get_terminal_size()
    width = min(cols - 4, 200)
    height = round(width * 78 / 200) // 2 * 2
    free = LIVE_EVENTS + 6
    if height // 2 > rows - free:
        height = (rows - free) * 2
        width = round(height * 200 / 78)
    if width < 40 or height < 10:
        return None
    return width, height, " " * ((cols - width) // 2)


def live_view():
    """What is happening right now: every second the statistics sets are read again.
    Each address whose counter went up makes its country blink on the map and appears
    in the list of the last requests. Nothing keeps running once the view is closed."""
    if read_conf()[1].get("STATS_MAX") == "0":
        msg(f"The live view needs the statistics, which are turned off "
            f"(STATS_MAX=\"0\" in {CONF}).", 8, 64)
        return
    if not table_loaded():
        msg("The rules are not loaded. Turn blocking on first.", 8, 60)
        return
    if not live_size():
        cols, rows = shutil.get_terminal_size()
        msg(f"The terminal is too small for the live view ({cols}x{rows}). "
            f"It needs at least 44x{LIVE_EVENTS + 11}.", 8, 64)
        return
    whiptail("--infobox", "Starting live view ...", "7", "50")
    country_of("0.0.0.0")       # loads the geo data now instead of at the first request
    base = map_colors({}, allowed())
    nets = blocked_nets()       # BLOCK_NETS does not change while the view is open
    last = all_hits()           # what was counted before the view opened is not shown
    events = []                 # newest first: (time, kind, address, country, requests)
    lit = {}                    # country -> (kind, time when it stops blinking)

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    # Alternate screen (the menu comes back unchanged), no cursor, keys without Enter
    sys.stdout.write("\033[?1049h\033[?25l")
    tty.setcbreak(fd)
    try:
        next_poll = 0.0
        while True:
            now = time.time()
            if now >= next_poll:
                current = all_hits()
                per_net = None  # addresses per network, only computed when needed
                for (kind, addr), n in current.items():
                    # Lower than before after a reset or a reload: no new request
                    new = n - last.get((kind, addr), 0)
                    if new > 0:
                        cc = country_of(addr)
                        if per_net is None:
                            per_net = addresses_per_net(a for _, a in current)
                        hint = address_hint(addr, nets, per_net)
                        events.insert(0, (now, kind, addr, cc, new, hint))
                        lit[cc] = (kind, now + LIVE_LIT)
                del events[LIVE_EVENTS:]
                last, next_poll = current, now + LIVE_POLL
            lit = {cc: v for cc, v in lit.items() if v[1] > now}
            draw_live(base, lit, events, now)
            # Half a second is the blink rhythm; a key ends the wait early
            if select.select([fd], [], [], 0.5)[0] and os.read(fd, 32)[:1] in (b"q", b"Q", b"\n", b"\x1b"):
                return
    except KeyboardInterrupt:
        return
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


def draw_live(base, lit, events, now):
    """One frame of the live view: map with the lit countries, then the last requests."""
    size = live_size()
    if not size:
        sys.stdout.write("\033[H\033[2J  The terminal is too small for the map. Press q to go back.")
        sys.stdout.flush()
        return
    width, height, pad = size
    blink = int(now * 2) % 2    # flips every half second
    colors = dict(base)
    for cc, (kind, _) in lit.items():
        colors[cc] = FLASH if blink else (RED if kind == "block" else GREEN)[2]
    lines = ["", f"  {BOLD}Live view{RESET}   requests as they come in - press q to go back", ""]
    # Lit countries count as traffic for render_map, so even tiny ones get a pixel
    lines += [pad + l for l in render_map({cc: (1, 0) for cc in lit}, colors, width, height)]
    lines += ["", f"  {BOLD}Last {LIVE_EVENTS} requests{RESET}"]
    for t, kind, addr, cc, n, hint in events:
        color, word = (RED[2], "blocked") if kind == "block" else (GREEN[2], "allowed")
        times = f"  x{n}" if n > 1 else ""
        hint = f"  {fg(HINT)}{hint}{RESET}" if hint else ""
        lines.append(f"  {time.strftime('%H:%M:%S', time.localtime(t))}  {fg(color)}{word}{RESET}  "
                     f"{addr:<39}  {country_name(cc)[:30]}{times}{hint}")
    if not events:
        lines.append("  Waiting for requests ...")
    # Overwrite in place instead of clearing the screen first, so nothing flickers.
    # \033[K clears the rest of each line, \033[J everything below the last one.
    sys.stdout.write("\033[H" + "\n".join(l + "\033[K" for l in lines) + "\033[J")
    sys.stdout.flush()


def top_lines(title, since, ranked, label_width, tag_width, bars):
    """Allowed and blocked top 10 side by side. ranked: {"allow"/"block": [(n, label, tag)]},
    tag is a short text such as the country code. bars adds a bar relative to the first place."""
    # Width of the left column: rank, label, tag, count, optional bar, gap
    width = 3 + label_width + 1 + tag_width + 1 + 7 + (7 if bars else 0) + 3
    cols = {}
    for kind, color in (("allow", GREEN[2]), ("block", RED[2])):
        top10 = sorted(ranked[kind], reverse=True)[:10]  # tuples sort by count first
        top = top10[0][0] if top10 else 1
        cols[kind] = []
        for r, (n, label, tag) in enumerate(top10):
            line = f"{r + 1:>2} {label[:label_width]:<{label_width}} {tag:>{tag_width}} {n:>7,}"
            if bars:
                line += " " + fg(color) + "▇" * max(1, round(6 * n / top)) + RESET
            cols[kind].append(line)
    lines = header(title, since)
    lines.append(f"  {BOLD}{fg(GREEN[2])}{'Allowed':<{width}}{fg(RED[2])}Blocked{RESET}")
    lines.append("")
    if not cols["allow"] and not cols["block"]:
        return lines + ["  No requests counted yet."]
    for kind in cols:
        cols[kind] = cols[kind] or ["   no requests"]
    for r in range(10):
        left = cols["allow"][r] if r < len(cols["allow"]) else ""
        right = cols["block"][r] if r < len(cols["block"]) else ""
        # Pad by the visible length: escape codes take no space on screen
        visible = len(re.sub(r"\033\[[0-9;]*m", "", left))
        lines.append("  " + left + " " * (width - visible) + right)
    return lines


def show_top_addresses(since):
    """Top 10 source addresses overall, with their country code and a hint mark.
    Typing an address opens the dialog to block its network."""
    countries, addrs = collect_stats()
    nets = blocked_nets()
    per_net = addresses_per_net(a for v in addrs.values() for _, a, _ in v)
    mark = {"listed": "x", "scanner?": "!", "": ""}
    ranked = {k: [(n, addr, f"{mark[address_hint(addr, nets, per_net)]:>1} {cc.upper()}")
                  for n, addr, cc in v] for k, v in addrs.items()}
    lines = (top_lines("Top 10 addresses (IPv6 grouped by /64)", since, ranked, 21, 4, False)
             + untracked_note(countries)
             + ["", f"  {fg(HINT)}!{RESET} scanner suspected (many addresses from its network)   "
                    "x in the blocked networks"])
    value = show_screen(lines, "Address to block its network, or Enter to go back: ").strip()
    if value:
        try:
            ipaddress.ip_address(value)
        except ValueError:
            msg(f"{value!r} is not an address.", 8, 60)
            return
        # Suggest the suspicious network if there is one, else the /24 (/48)
        add_blocked_net(suspect_net(value, per_net) or net_of(value))


def suspicious_networks(addrs):
    """Suspicious networks (see SCANNER_LEVELS), most addresses first:
    [(addresses, requests, network, country, allowed, blocked)]. Each address belongs to
    its smallest suspicious network, so a /24 and the /22 around it are not counted twice."""
    per_net = addresses_per_net(a for v in addrs.values() for _, a, _ in v)
    nets = {}
    for kind in ("allow", "block"):
        for n, addr, cc in addrs[kind]:
            net = suspect_net(addr, per_net)
            if net:
                e = nets.setdefault(net, {"addrs": set(), "allow": 0, "block": 0, "cc": cc})
                e["addrs"].add(addr)
                e[kind] += n
    return sorted(((len(e["addrs"]), e["allow"] + e["block"], net, e["cc"], e["allow"], e["block"])
                   for net, e in nets.items()), reverse=True)


def show_suspicious(since):
    """Networks that look like scanners; typing a number opens the dialog to block one."""
    countries, addrs = collect_stats()
    rows = suspicious_networks(addrs)[:15]
    nets = blocked_nets()
    lines = header("Suspicious networks", since)
    levels = ", ".join(f"/{p} with {m}+" for v in (4, 6) for p, m in SCANNER_LEVELS[v])
    lines += [f"  Networks with many different source addresses ({levels}).",
              "  Scanners rotate through the addresses of their block; normal visitors rarely do.",
              "  This is only a hint: many users behind one provider can look the same.", ""]
    if not rows:
        show_screen(lines + ["  None found."])
        return
    lines.append(f"  {BOLD} #  {'Network':<22} {'Addresses':>9} {'Requests':>9} "
                 f"{'Allowed':>8} {'Blocked':>8}  Country{RESET}")
    for i, (count, total, net, cc, a, b) in enumerate(rows, 1):
        listed = "  (blocked network)" if in_networks(net, nets) else ""
        lines.append(f"  {i:>2}  {net:<22} {count:>9} {total:>9,} {fg(GREEN[2])}{a:>8,}{RESET} "
                     f"{fg(RED[2])}{b:>8,}{RESET}  {country_name(cc)[:20]}{listed}")
    choice = show_screen(lines, "Number to block that network, or Enter to go back: ").strip()
    if choice.isdigit() and 1 <= int(choice) <= len(rows):
        add_blocked_net(rows[int(choice) - 1][2])


def show_top_countries(since):
    """Top 10 countries; typing a country code opens the top 10 addresses of that country."""
    countries, addrs = collect_stats()
    # i = 0 for allowed, 1 for blocked, matching the [allowed, blocked] lists in countries
    ranked = {k: [(v[i], country_name(cc), cc.upper()) for cc, v in countries.items() if v[i]]
              for i, k in enumerate(("allow", "block"))}
    note = []  # extra lines below the list, e.g. for an unknown code
    while True:
        lines = top_lines("Top 10 countries", since, ranked, 14, 2, True) + untracked_note(countries) + note
        cc = show_screen(lines, "Country code for its top 10 addresses, or Enter to go back: ").strip().lower()
        if not cc:
            return
        if cc not in countries:
            note = ["", f"  No requests from {cc.upper()}."]
            continue
        note = []
        total = countries[cc]
        # The tag column shows each address' share of its country's requests
        by_addr = {k: [(n, addr, f"{100 * n / total[i]:.0f}%") for n, addr, c in addrs[k] if c == cc]
                   for i, k in enumerate(("allow", "block"))}
        show_screen(top_lines(f"Top 10 addresses from {country_name(cc)} ({cc.upper()})", since,
                              by_addr, 21, 4, False)
                    + ["", "  % = share of the allowed or blocked requests from this country"])


def reset_stats():
    """Empties the statistics sets and counters and sets the start time to now."""
    ok, _ = whiptail("--defaultno", "--yesno",
                     "Delete all statistics and start counting again from now?", "8", "64")
    if not ok:
        return
    # Flush all four sets in one transaction, read from stdin
    r = subprocess.run(["nft", "-f", "-"], capture_output=True, text=True,
                       input="".join(f"flush set inet geowarden {s}\n" for s in STAT_SETS))
    for name in ("allowed", "blocked"):
        subprocess.run(["nft", "reset", "counter", "inet", "geowarden", name], capture_output=True)
    if r.returncode != 0:
        msg(f"Reset failed:\n\n{r.stderr.strip()}", 12, 70)
        return
    with open(STATS_SINCE + ".tmp", "w") as f:
        f.write(f"{int(time.time())}\n")
    os.replace(STATS_SINCE + ".tmp", STATS_SINCE)
    msg("Statistics reset. Counting starts again now.", 8, 52)


def statistics():
    """Statistics submenu; loops until Back."""
    while True:
        since = stats_since()
        if read_conf()[1].get("STATS_MAX") == "0":
            msg(f"Statistics are turned off (STATS_MAX=\"0\" in {CONF}).", 8, 64)
            return
        if since is None:
            msg("No statistics available. They are collected while blocking is on "
                "and the rules are loaded.", 9, 64)
            return
        ok, choice = whiptail("--cancel-button", "Back", "--menu",
                              f"Statistics since {format_time(since)}\n"
                              f"Requests: {counter('allowed'):,} allowed, {counter('blocked'):,} blocked",
                              "16", "66", "5",
                              "1", "World map",
                              "2", "Top 10 countries",
                              "3", "Top 10 addresses",
                              "4", "Suspicious networks (scanner hint)",
                              "5", "Reset statistics")
        if not ok:
            return
        if choice == "1":
            show_map(since)
        elif choice == "2":
            show_top_countries(since)
        elif choice == "3":
            show_top_addresses(since)
        elif choice == "4":
            show_suspicious(since)
        else:
            reset_stats()


def main():
    """Main menu; loops until Quit. Needs root for nft and for writing the config."""
    if os.geteuid() != 0:
        sys.exit("geowarden must be run as root.")
    if len(sys.argv) > 1:
        sys.exit("Usage: geowarden (no arguments)")
    while True:
        state = "ON" if enabled() else "OFF"
        ok, choice = whiptail("--cancel-button", "Quit", "--menu",
                              f"Blocking is {state} - {len(allowed())} countries allowed", "18", "60", "7",
                              "1", "Show status",
                              "2", "Turn blocking off" if state == "ON" else "Turn blocking on",
                              "3", "Edit countries (by continent)",
                              "4", "Show allowed countries",
                              "5", "Blocked networks",
                              "6", "Statistics and world map",
                              "7", "Live view")
        if not ok:
            return
        # Dispatch the chosen menu tag to its function
        {"1": show_status, "2": toggle_enabled, "3": edit_countries, "4": show_allowed,
         "5": edit_blocked_nets, "6": statistics, "7": live_view}[choice]()


if __name__ == "__main__":
    main()
