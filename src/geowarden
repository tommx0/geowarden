COUNTRIES = {}  # code -> (continent, name)
for line in COUNTRY_TABLE.strip().splitlines():
    code, cont, name = line.split(" ", 2)
    COUNTRIES[code.lower()] = (cont, name)


def sortkey(name):
    """Sorts Å like A etc."""
    return unicodedata.normalize("NFD", name).encode("ascii", "ignore").decode().lower()


def whiptail(*args):
    """Runs whiptail; returns (ok, selection)."""
    r = subprocess.run(["whiptail", "--title", TITLE, *args], stderr=subprocess.PIPE, text=True)
    return r.returncode == 0, r.stderr.strip()


def msg(text, h=12, w=70):
    whiptail("--msgbox", text, str(h), str(w))


def read_conf():
    with open(CONF) as f:
        text = f.read()
    vals = dict(re.findall(r'^(\w+)="([^"]*)"', text, re.M))
    return text, vals


def write_conf(key, value):
    text, _ = read_conf()
    new = re.sub(rf'^{key}="[^"]*"', f'{key}="{value}"', text, count=1, flags=re.M)
    if new == text and f'{key}="{value}"' not in text:
        new = f'{key}="{value}"\n' + text
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.replace(tmp, CONF)


def allowed():
    return set(read_conf()[1].get("COUNTRIES", "").split())


def enabled():
    return read_conf()[1].get("ENABLED", "no") == "yes"


def table_loaded():
    return subprocess.run(["nft", "list", "chain", "inet", "geowarden", "prerouting"],
                          capture_output=True).returncode == 0


def counter(name):
    r = subprocess.run(["nft", "list", "counter", "inet", "geowarden", name],
                       capture_output=True, text=True)
    m = re.search(r"packets (\d+)", r.stdout)
    return int(m.group(1)) if m else 0


def wan_ifaces():
    """Filtered interfaces: WAN_IF from the config, otherwise those of the default routes."""
    conf = read_conf()[1].get("WAN_IF", "").split()
    if conf:
        return conf
    found = []
    for fam in ("-4", "-6"):
        out = subprocess.run(["ip", fam, "-o", "route", "show", "default"],
                             capture_output=True, text=True).stdout
        found += re.findall(r"\bdev (\S+)", out)
    return sorted(set(found))


def ssh_warning():
    """Warns if our own SSH connection comes in via a public interface and is not allowed."""
    client = os.environ.get("SSH_CLIENT", "").split(" ")[0]
    if not client or not table_loaded():
        return ""
    route = subprocess.run(["ip", "route", "get", client], capture_output=True, text=True).stdout
    if not any(f"dev {w} " in route for w in wan_ifaces()):
        return ""
    setname = "allow6" if ":" in client else "allow4"
    r = subprocess.run(["nft", "get", "element", "inet", "geowarden", setname, f"{{ {client} }}"],
                       capture_output=True)
    if r.returncode != 0:
        return (f"\n\nWARNING: Your SSH address {client} is not allowed. The current "
                "connection stays open, but a new one will be blocked!")
    return ""


def apply():
    whiptail("--infobox", "Applying rules ...", "7", "50")
    r = subprocess.run([APPLY], capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        msg(f"Applying failed, the previous rules stay active:\n\n{out}", 14, 76)
    else:
        msg(out + ssh_warning(), 12, 76)


def set_countries(codes):
    if not codes and enabled():
        ok, _ = whiptail("--defaultno", "--yesno",
                         "No country allowed: the server would then be blocked from everywhere "
                         "(except port 80 and Tailscale).\n\nSave anyway?", "11", "70")
        if not ok:
            return
    write_conf("COUNTRIES", " ".join(sorted(codes)))
    if enabled():
        apply()


def show_status():
    a = allowed()
    per = "\n".join(
        f"  {name:<38} {sum(1 for c in a if COUNTRIES.get(c, ('',))[0] == key):>3} of "
        f"{sum(1 for v in COUNTRIES.values() if v[0] == key)}"
        for key, name in CONTINENTS)
    cache = geo_files()
    since = stats_since()
    msg(f"Blocking (config):     {'ON' if enabled() else 'OFF'}\n"
        f"Rules loaded:          {'yes' if table_loaded() else 'no'}\n"
        f"Statistics since:      {format_time(since) if since else '-'}\n"
        f"Requests:              {counter('allowed'):,} allowed, {counter('blocked'):,} blocked\n"
        f"Geo data:              {cache[-1] if cache else '-'}\n"
        f"Filtered interfaces:   {' '.join(wan_ifaces()) or '-'}\n\n"
        f"Allowed countries: {len(a)}\n{per}", 21, 66)


def show_allowed():
    a = allowed()
    lines = []
    for key, cname in CONTINENTS:
        names = sorted((COUNTRIES[c][1] for c in a if COUNTRIES.get(c, ("",))[0] == key), key=sortkey)
        if names:
            lines.append(f"{cname}:\n  " + ", ".join(names))
    unknown = sorted(c.upper() for c in a if c not in COUNTRIES)
    if unknown:
        lines.append("Unknown codes: " + ", ".join(unknown))
    msg("\n\n".join(lines) or "No country allowed.", 22, 76)


def toggle_enabled():
    if enabled():
        ok, _ = whiptail("--defaultno", "--yesno",
                         "Turn blocking off? The server will then be reachable from all countries again.",
                         "9", "64")
        if ok:
            write_conf("ENABLED", "no")
            apply()
    else:
        write_conf("ENABLED", "yes")
        apply()


def edit_continent(key, cname):
    codes = sorted((c for c, v in COUNTRIES.items() if v[0] == key), key=lambda c: sortkey(COUNTRIES[c][1]))
    a = allowed()
    ok, choice = whiptail("--menu", cname, "13", "60", "3",
                          "1", "Select countries individually",
                          "2", "Allow all",
                          "3", "Block all")
    if not ok:
        return
    if choice == "2":
        set_countries(a | set(codes))
    elif choice == "3":
        set_countries(a - set(codes))
    else:
        items = []
        for c in codes:
            items += [c.upper(), COUNTRIES[c][1], "ON" if c in a else "OFF"]
        ok, sel = whiptail("--separate-output", "--checklist",
                           f"{cname}: Space = on/off, Enter = save",
                           "22", "64", "14", *items)
        if not ok:
            return
        chosen = {s.lower() for s in sel.split()}
        new = (a - set(codes)) | chosen
        if new != a:
            set_countries(new)


def edit_countries():
    while True:
        a = allowed()
        items = []
        for key, cname in CONTINENTS:
            total = sum(1 for v in COUNTRIES.values() if v[0] == key)
            n = sum(1 for c in a if COUNTRIES.get(c, ("",))[0] == key)
            items += [key, f"{cname}  ({n}/{total} allowed)"]
        ok, choice = whiptail("--cancel-button", "Back", "--menu",
                              "Choose a continent:", "16", "64", str(len(CONTINENTS)), *items)
        if not ok:
            return
        edit_continent(choice, dict(CONTINENTS)[choice])


# --- Statistics ---------------------------------------------------------------
# The rules count every request that reaches the country check, per source address
# (IPv6 per /64) in the sets STAT_SETS, plus the totals in the counters "allowed"
# and "blocked". A request is a packet that opens a new connection, so a client
# that retries a blocked connection is counted once per attempt.

def geo_files():
    return sorted(f for f in os.listdir(CACHE) if f.startswith("dbip-")) if os.path.isdir(CACHE) else []


def format_time(t):
    mins = int(time.time() - t) // 60
    if mins < 60:
        ago = f"{mins} min"
    elif mins < 48 * 60:
        ago = f"{mins // 60} h {mins % 60} min"
    else:
        ago = f"{mins // 1440} days {mins % 1440 // 60} h"
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) + f" ({ago} ago)"


def stats_since():
    """Start time of the statistics, None while no statistics are collected."""
    try:
        with open(STATS_SINCE) as f:
            since = int(f.read().strip())
    except (OSError, ValueError):
        return None
    r = subprocess.run(["nft", "list", "set", "inet", "geowarden", STAT_SETS[-1]], capture_output=True)
    return since if r.returncode == 0 else None


def address_hits(setname):
    """{address: requests} from one of the statistics sets."""
    r = subprocess.run(["nft", "-j", "list", "set", "inet", "geowarden", setname],
                       capture_output=True, text=True)
    hits = {}
    if r.returncode == 0:
        for obj in json.loads(r.stdout)["nftables"]:
            for e in obj.get("set", {}).get("elem", []):
                e = e.get("elem", e) if isinstance(e, dict) else {"val": e}
                hits[e["val"]] = e.get("counter", {}).get("packets", 0)
    return hits


_geo = {}


def country_of(addr):
    """Country code (lower case) of an address from the cached DB-IP file, "zz" if unknown."""
    files = geo_files()
    if not files:
        return "zz"
    if _geo.get("file") != files[-1]:
        ranges = {4: [], 6: []}
        with gzip.open(os.path.join(CACHE, files[-1]), "rt") as f:
            for line in f.read().splitlines():
                ranges[6 if ":" in line[:line.find(",")] else 4].append(line)
        starts = {v: [ip_int(l[:l.find(",")]) for l in lines] for v, lines in ranges.items()}
        _geo.update(file=files[-1], ranges=ranges, starts=starts)
    n = ip_int(addr)
    version = 6 if ":" in addr else 4
    i = bisect.bisect_right(_geo["starts"][version], n) - 1
    if i >= 0:
        _, end, cc = _geo["ranges"][version][i].split(",")
        if ip_int(end) >= n:
            return cc.lower()
    return "zz"


def ip_int(addr):
    family = socket.AF_INET6 if ":" in addr else socket.AF_INET
    return int.from_bytes(socket.inet_pton(family, addr), "big")


def collect_stats():
    """Requests per country {cc: [allowed, blocked]} and per address {"allow"/"block": [(n, addr, cc)]}."""
    whiptail("--infobox", "Loading statistics ...", "7", "50")
    countries, addrs = {}, {"allow": [], "block": []}
    for kind in addrs:
        for fam in (4, 6):
            for addr, n in address_hits(f"stat_{kind}{fam}").items():
                cc = country_of(addr)
                countries.setdefault(cc, [0, 0])[kind == "block"] += n
                addrs[kind].append((n, addr, cc))
    return countries, addrs


def country_name(cc):
    return COUNTRIES.get(cc, ("", "Unknown" if cc == "zz" else cc.upper()))[1]


def fg(color):
    return f"\033[38;5;{color}m"


def show_screen(lines, prompt="Press Enter to go back "):
    """Shows colored text on the plain terminal; returns what was typed before Enter."""
    sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n\n  " + prompt)
    sys.stdout.flush()
    try:
        return input()
    except (EOFError, KeyboardInterrupt):
        return ""


def untracked_note(countries):
    """Note about requests that are only in the totals because an address list was full."""
    missing = counter("allowed") + counter("blocked") - sum(sum(v) for v in countries.values())
    if missing <= 0:
        return []
    return [f"  {missing:,} requests are only in the totals: an address list is full (STATS_MAX)"]


def header(title, since):
    return ["", f"  {BOLD}{title}{RESET}",
            f"  Since {format_time(since)}",
            f"  Requests: {fg(GREEN[2])}{counter('allowed'):,} allowed{RESET}, "
            f"{fg(RED[2])}{counter('blocked'):,} blocked{RESET}", ""]


def map_colors(countries, allow):
    """Color per country: red/green by the kind of requests, brighter = more requests."""
    top = max((sum(v) for v in countries.values()), default=0)
    colors = {}
    for cc in set(COUNTRIES) | set(countries):
        a, b = countries.get(cc, (0, 0))
        if a + b:
            share = math.log1p(a + b) / math.log1p(top)
            level = 2 if share > 0.8 else 1 if share > 0.55 else 0
            colors[cc] = (RED if b >= a else GREEN)[level]
        else:
            colors[cc] = QUIET_ALLOWED if cc in allow else QUIET_BLOCKED
    return colors


def render_map(countries, colors, width, height):
    """Scales the world map to width x height pixels, two pixels per character (half blocks)."""
    with open(WORLDMAP) as f:
        grid = [[r[i:i + 2].lower() for i in range(0, len(r) - 1, 2)]
                for r in f.read().splitlines() if not r.startswith("#")]
    sh, sw = len(grid), len(grid[0])
    traffic = lambda cc: sum(countries.get(cc, (0, 0)))
    pix = [[None] * width for _ in range(height)]
    for y in range(height):
        y0 = y * sh // height
        y1 = max(y0 + 1, (y + 1) * sh // height)
        for x in range(width):
            x0 = x * sw // width
            x1 = max(x0 + 1, (x + 1) * sw // width)
            cells = [grid[j][i] for j in range(y0, y1) for i in range(x0, x1)]
            land = [c for c in cells if c != ".."]
            if len(land) * 3 >= len(cells):
                busy = [c for c in land if traffic(c)]
                pix[y][x] = max(busy, key=traffic) if busy else max(sorted(set(land)), key=land.count)
    # Countries with requests stay visible even when they are smaller than a pixel
    shown = {c for row in pix for c in row}
    for j, row in enumerate(grid):
        for i, cc in enumerate(row):
            if cc != ".." and cc not in shown and traffic(cc):
                pix[j * height // sh][i * width // sw] = cc
                shown.add(cc)

    lines = []
    for y in range(0, height - 1, 2):
        out, last = [], None
        for top, bottom in zip(pix[y], pix[y + 1]):
            t = colors.get(top, QUIET_BLOCKED) if top else None
            b = colors.get(bottom, QUIET_BLOCKED) if bottom else None
            if t is None and b is None:
                style, ch = RESET, " "
            elif b is None or t == b:
                style, ch = RESET + fg(t), "█" if t == b else "▀"
            elif t is None:
                style, ch = RESET + fg(b), "▄"
            else:
                style, ch = fg(t) + f"\033[48;5;{b}m", "▀"
            if style != last:
                out.append(style)
                last = style
            out.append(ch)
        lines.append("".join(out) + RESET)
    return lines


def show_map(since):
    countries, _ = collect_stats()
    cols, rows = shutil.get_terminal_size()
    width = min(cols - 4, 200)
    height = round(width * 78 / 200) // 2 * 2
    if height // 2 > rows - 11:
        height = (rows - 11) * 2
        width = round(height * 200 / 78)
    if width < 40 or height < 10:
        msg(f"The terminal is too small for the map ({cols}x{rows}). It needs at least 44x16.", 8, 60)
        return
    pad = " " * ((cols - width) // 2)
    lines = header("Requests by country", since)
    lines += [pad + l for l in render_map(countries, map_colors(countries, allowed()), width, height)]
    shade = lambda pal: "".join(fg(c) + "█" for c in pal) + RESET
    lines += ["", f"  {shade(RED)} blocked requests   {shade(GREEN)} allowed requests   (darker = fewer)",
              f"  {fg(QUIET_ALLOWED)}█{RESET} allowed country, no requests   "
              f"{fg(QUIET_BLOCKED)}█{RESET} blocked country, no requests"]
    show_screen(lines + untracked_note(countries))


def top_lines(title, since, ranked, label_width, tag_width, bars):
    """Allowed and blocked top 10 side by side. ranked: {"allow"/"block": [(n, label, tag)]},
    tag is a short text such as the country code."""
    width = 3 + label_width + 1 + tag_width + 1 + 7 + (7 if bars else 0) + 3
    cols = {}
    for kind, color in (("allow", GREEN[2]), ("block", RED[2])):
        top10 = sorted(ranked[kind], reverse=True)[:10]
        top = top10[0][0] if top10 else 1
        cols[kind] = []
        for r, (n, label, tag) in enumerate(top10):
            line = f"{r + 1:>2} {label[:label_width]:<{label_width}} {tag:>{tag_width}} {n:>7,}"
            if bars:
                line += " " + fg(color) + "▇" * max(1, round(6 * n / top)) + RESET
            cols[kind].append(line)
    lines = header(title, since)
    lines.append(f"  {BOLD}{fg(GREEN[2])}{'Allowed':<{width}}{fg(RED[2])}Blocked{RESET}")
    lines.append("")
    if not cols["allow"] and not cols["block"]:
        return lines + ["  No requests counted yet."]
    for kind in cols:
        cols[kind] = cols[kind] or ["   no requests"]
    for r in range(10):
        left = cols["allow"][r] if r < len(cols["allow"]) else ""
        right = cols["block"][r] if r < len(cols["block"]) else ""
        visible = len(re.sub(r"\033\[[0-9;]*m", "", left))
        lines.append("  " + left + " " * (width - visible) + right)
    return lines


def show_top_addresses(since):
    countries, addrs = collect_stats()
    ranked = {k: [(n, addr, cc.upper()) for n, addr, cc in v] for k, v in addrs.items()}
    show_screen(top_lines("Top 10 addresses (IPv6 grouped by /64)", since, ranked, 21, 2, False)
                + untracked_note(countries))


def show_top_countries(since):
    """Top 10 countries; typing a country code opens the top 10 addresses of that country."""
    countries, addrs = collect_stats()
    ranked = {k: [(v[i], country_name(cc), cc.upper()) for cc, v in countries.items() if v[i]]
              for i, k in enumerate(("allow", "block"))}
    note = []
    while True:
        lines = top_lines("Top 10 countries", since, ranked, 14, 2, True) + untracked_note(countries) + note
        cc = show_screen(lines, "Country code for its top 10 addresses, or Enter to go back: ").strip().lower()
        if not cc:
            return
        if cc not in countries:
            note = ["", f"  No requests from {cc.upper()}."]
            continue
        note = []
        total = countries[cc]
        by_addr = {k: [(n, addr, f"{100 * n / total[i]:.0f}%") for n, addr, c in addrs[k] if c == cc]
                   for i, k in enumerate(("allow", "block"))}
        show_screen(top_lines(f"Top 10 addresses from {country_name(cc)} ({cc.upper()})", since,
                              by_addr, 21, 4, False)
                    + ["", "  % = share of the allowed or blocked requests from this country"])


def reset_stats():
    ok, _ = whiptail("--defaultno", "--yesno",
                     "Delete all statistics and start counting again from now?", "8", "64")
    if not ok:
        return
    r = subprocess.run(["nft", "-f", "-"], capture_output=True, text=True,
                       input="".join(f"flush set inet geowarden {s}\n" for s in STAT_SETS))
    for name in ("allowed", "blocked"):
        subprocess.run(["nft", "reset", "counter", "inet", "geowarden", name], capture_output=True)
    if r.returncode != 0:
        msg(f"Reset failed:\n\n{r.stderr.strip()}", 12, 70)
        return
    with open(STATS_SINCE + ".tmp", "w") as f:
        f.write(f"{int(time.time())}\n")
    os.replace(STATS_SINCE + ".tmp", STATS_SINCE)
    msg("Statistics reset. Counting starts again now.", 8, 52)


def statistics():
    while True:
        since = stats_since()
        if read_conf()[1].get("STATS_MAX") == "0":
            msg(f"Statistics are turned off (STATS_MAX=\"0\" in {CONF}).", 8, 64)
            return
        if since is None:
            msg("No statistics available. They are collected while blocking is on "
                "and the rules are loaded.", 9, 64)
            return
        ok, choice = whiptail("--cancel-button", "Back", "--menu",
                              f"Statistics since {format_time(since)}\n"
                              f"Requests: {counter('allowed'):,} allowed, {counter('blocked'):,} blocked",
                              "15", "66", "4",
                              "1", "World map",
                              "2", "Top 10 countries",
                              "3", "Top 10 addresses",
                              "4", "Reset statistics")
        if not ok:
            return
        if choice == "1":
            show_map(since)
        elif choice == "2":
            show_top_countries(since)
        elif choice == "3":
            show_top_addresses(since)
        else:
            reset_stats()


def main():
    if os.geteuid() != 0:
        sys.exit("geowarden must be run as root.")
    if len(sys.argv) > 1:
        sys.exit("Usage: geowarden (no arguments)")
    while True:
        state = "ON" if enabled() else "OFF"
        ok, choice = whiptail("--cancel-button", "Quit", "--menu",
                              f"Blocking is {state} - {len(allowed())} countries allowed", "16", "60", "5",
                              "1", "Show status",
                              "2", "Turn blocking off" if state == "ON" else "Turn blocking on",
                              "3", "Edit countries (by continent)",
                              "4", "Show allowed countries",
                              "5", "Statistics and world map")
        if not ok:
            return
        {"1": show_status, "2": toggle_enabled, "3": edit_countries, "4": show_allowed,
         "5": statistics}[choice]()


if __name__ == "__main__":
    main()
