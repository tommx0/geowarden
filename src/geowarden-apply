#!/usr/bin/python3 -I
"""geowarden-apply - loads the country allowlist into the nftables table "inet geowarden".

Reads /etc/geowarden.conf, takes the IP ranges of the allowed countries from the DB-IP
geolocation data and loads them together with the filter chain. New connections on the
public interfaces from any other address are dropped. Run daily by geowarden.timer and
by the menu "geowarden" after every change.

If anything goes wrong (download, data, configuration, nft) the current rules stay as
they are and the script exits with an error message.
"""
import csv
import datetime
import gzip
import http.client
import ipaddress
import os
import re
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

CONF = "/etc/geowarden.conf"
CACHE = "/var/cache/geowarden"
# Start time of the statistics. Like the kernel counters, it does not survive a reboot.
STATS_SINCE = "/run/geowarden/stats-since"
TABLE = "inet geowarden"

# Geolocation data: "IP Geolocation by DB-IP" (https://db-ip.com), license CC BY 4.0.
# Published monthly as CSV lines "start,end,COUNTRY".
SOURCE = "https://download.db-ip.com/free/dbip-country-lite-{month}.csv.gz"
MIN_LINES = 100000  # a complete file has far more lines; fewer means a broken download

# IPv6 statistics count per /64 network
V6NET = "ffff:ffff:ffff:ffff::"


class Error(Exception):
    """Ends the script with a message; the current rules stay as they are."""


# --- Configuration ----------------------------------------------------------------------

def read_conf():
    """Lines KEY="value", the same format the menu reads and writes."""
    if not os.access(CONF, os.R_OK):
        raise Error(f"{CONF} is missing")
    with open(CONF) as f:
        return dict(re.findall(r'^(\w+)="([^"]*)"', f.read(), re.M))


def words(conf, key, pattern, what):
    """The space-separated values of a key, each checked against a pattern."""
    values = conf.get(key, "").split()
    for v in values:
        if not re.fullmatch(pattern, v):
            raise Error(f"{key} in {CONF}: {v!r} is not {what}")
    return values


def ports(conf, key):
    """Port numbers or ranges like 8000-8100."""
    values = words(conf, key, r"\d{1,5}(-\d{1,5})?", "a port or port range")
    for v in values:
        lo, _, hi = v.partition("-")
        if not 1 <= int(lo) <= int(hi or lo) <= 65535:
            raise Error(f"{key} in {CONF}: {v!r} is not a valid port or port range")
    return values


def networks(conf, key):
    """Networks or single addresses such as 109.196.32.0/21, 203.0.113.7 or 2001:db8::/32,
    per IP version. Host bits are cleared (109.196.36.1/21 becomes 109.196.32.0/21) and
    overlapping entries are joined, so the set gets no overlapping elements."""
    found = {4: [], 6: []}
    for v in conf.get(key, "").split():
        try:
            net = ipaddress.ip_network(v, strict=False)
        except ValueError:
            raise Error(f"{key} in {CONF}: {v!r} is not a network or address")
        found[net.version].append(net)
    return {version: [str(n) for n in ipaddress.collapse_addresses(nets)]
            for version, nets in found.items()}


def yes_no(conf, key, default):
    """A yes/no setting; default if the key is missing (older configurations)."""
    value = conf.get(key, default)
    if value not in ("yes", "no"):
        raise Error(f"{key} in {CONF} must be \"yes\" or \"no\"")
    return value == "yes"


def default_route_ifaces():
    """Interfaces of the default routes (IPv4 and IPv6)."""
    found = set()
    for family in ("-4", "-6"):
        out = subprocess.run(["ip", family, "-o", "route", "show", "default"],
                             capture_output=True, text=True).stdout
        found.update(re.findall(r"\bdev (\S+)", out))
    return sorted(found)


# --- Geo data ---------------------------------------------------------------------------

def nonempty(path):
    """True if the file exists and is not empty."""
    return os.path.exists(path) and os.path.getsize(path) > 0


def months():
    """This month and the previous one: early in the month the new file may not be out yet."""
    today = datetime.date.today()
    last_month = today.replace(day=1) - datetime.timedelta(days=1)
    return [today.strftime("%Y-%m"), last_month.strftime("%Y-%m")]


def ip_int(text, version):
    """Address as integer. inet_pton accepts only well-formed addresses of this family
    and is much faster than ipaddress for the more than a million addresses."""
    family = socket.AF_INET6 if version == 6 else socket.AF_INET
    return int.from_bytes(socket.inet_pton(family, text), "big")


def read_ranges(path, countries):
    """Reads a DB-IP file and returns the ranges of the countries as (start, end) integers,
    separately for IPv4 and IPv6. Every line is parsed, so a damaged file raises an error
    instead of silently missing ranges."""
    ranges = {4: [], 6: []}
    lines = 0  # also the line number in error messages
    try:
        with gzip.open(path, "rt", newline="") as f:
            for lines, row in enumerate(csv.reader(f), 1):
                start, end, cc = row  # ValueError if a line has not exactly three fields
                version = 6 if ":" in start else 4
                start, end = ip_int(start, version), ip_int(end, version)
                if start > end:
                    raise ValueError("start after end")
                if cc.lower() in countries:
                    ranges[version].append((start, end))
    # OSError: unreadable or not gzip; EOFError: truncated download;
    # ValueError: malformed line or address (inet_pton raises OSError for those as well)
    except (OSError, EOFError, ValueError) as e:
        raise Error(f"{os.path.basename(path)}, line {lines}: {e}")
    if lines < MIN_LINES:
        raise Error(f"{os.path.basename(path)}: only {lines} lines")
    return ranges


def download(url, path):
    """Downloads a file, with retries like curl --retry 3."""
    request = urllib.request.Request(url, headers={"User-Agent": "geowarden"})
    for attempt in range(4):  # first try plus 3 retries
        try:
            with urllib.request.urlopen(request, timeout=60) as r, open(path, "wb") as f:
                # Stream in 64 KiB chunks instead of holding the whole file in memory
                while True:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        return
                    f.write(chunk)
        except urllib.error.HTTPError as e:
            if e.code < 500:  # e.g. 404: file of this month not published yet
                raise Error(f"{url}: {e}")
            error = e  # server error: worth retrying
        except (OSError, http.client.HTTPException) as e:
            error = e  # network error or connection dropped mid-download
        time.sleep(2 ** attempt)  # back off 1, 2, 4, 8 seconds
    raise Error(f"{url}: {error}")


def load_geo_data(countries):
    """The ranges from the cached file of this (or last) month; downloads it if needed."""
    os.makedirs(CACHE, exist_ok=True)
    errors = []  # collected per attempt, shown only if all of them fail
    # For each month, newest first: use the cache if valid, else download it
    for month in months():
        cached = os.path.join(CACHE, f"dbip-{month}.csv.gz")
        if nonempty(cached):
            try:
                return read_ranges(cached, countries)
            except Error as e:
                errors.append(str(e))
                os.remove(cached)  # damaged, download it again
        # Downloaded next to the cache file, so that replacing it stays on one file system
        part = cached + ".part"
        try:
            download(SOURCE.format(month=month), part)
            ranges = read_ranges(part, countries)
        except Error as e:
            errors.append(str(e))
            if os.path.exists(part):
                os.remove(part)
            continue
        # Only a file that was read without errors becomes the cache file
        os.replace(part, cached)
        # Remove older months, so the cache holds a single file
        for name in os.listdir(CACHE):
            if name.startswith("dbip-") and name.endswith(".csv.gz") and name != os.path.basename(cached):
                os.remove(os.path.join(CACHE, name))
        return ranges
    raise Error("Download failed - rules left unchanged\n" + "\n".join(errors))


def merge(ranges):
    """Joins overlapping and adjacent ranges: neighbouring blocks of allowed countries
    become one set element. That about halves the elements nft has to load."""
    merged = []
    for start, end in sorted(ranges):
        # Starts inside or right after the previous range: extend that one
        if merged and start <= merged[-1][1] + 1:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return merged


def nft_elements(ranges, version):
    """nft range "start-end", a single address without "-" (older nft rejects "a-a")."""
    addr = ipaddress.IPv4Address if version == 4 else ipaddress.IPv6Address
    return [str(addr(s)) if s == e else f"{addr(s)}-{addr(e)}" for s, e in ranges]


# --- nftables ---------------------------------------------------------------------------

def nft(*args, check=True):
    """Runs nft. With check, a failure ends the script; otherwise the caller
    looks at the result itself."""
    r = subprocess.run(["nft", *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Error(f"nft {' '.join(args)} failed - rules left unchanged\n{r.stderr.strip()}")
    return r


def body(allow4, allow6, deny4, deny6, block_open_ports, wan_if, open_tcp, open_udp, stats):
    """Allow sets and the chain. Requests that reach the country check are counted per
    source address in dynamic sets for the statistics in the menu.

    Returns the lines that go inside "table inet geowarden { ... }". The rules are checked
    from top to bottom; the first accept or drop ends the check for a packet."""
    lines = []
    # Interval sets hold address ranges; auto-merge joins overlapping elements
    for name, addr_type, elements in (("allow4", "ipv4_addr", allow4),
                                      ("allow6", "ipv6_addr", allow6)):
        lines.append(f"  set {name} {{ type {addr_type}; flags interval; auto-merge;")
        if elements:
            lines += [" elements = {", ",".join(elements), " }"]
        lines.append("  }")
    # Blocked networks (BLOCK_NETS): already joined, so no auto-merge needed. The same
    # definition is used in keep_ruleset, which must match it exactly.
    for name, addr_type, elements in (("deny4", "ipv4_addr", deny4), ("deny6", "ipv6_addr", deny6)):
        lines.append(f"  set {name} {{ type {addr_type}; flags interval;")
        if elements:
            lines += [" elements = {", ",".join(elements), " }"]
        lines.append("  }")

    ifaces = ", ".join(f'"{i}"' for i in wan_if)
    lines += [
        "  chain prerouting {",
        # priority -150: after conntrack (-200), before DNAT e.g. by Docker (-100)
        # policy accept: this chain only drops; other firewalls keep working as before
        "    type filter hook prerouting priority -150; policy accept;",
        # Only the public interfaces are filtered (VPN, Docker, lo are not)
        f"    iifname != {{ {ifaces} }} accept",
        # Replies and existing connections, also the own outgoing ones: only new
        # connections are checked, so an open SSH session is never cut off
        "    ct state established,related accept",
    ]
    # Traffic the server needs to keep its own network working. It comes first, so that
    # not even a blocked network can cut the server off from its router.
    lines += [
        "    udp sport 67 udp dport 68 accept",  # DHCP replies from the provider
        "    ip6 saddr fe80::/10 accept",        # IPv6 link-local (router, neighbours)
        # IPv6 neighbour discovery and router adverts (address and default route)
        "    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept",
    ]
    # Blocked networks are dropped whatever their country. They count as blocked requests,
    # so they show up in the statistics and the live view like any other block.
    deny = []
    if stats:
        deny.append("    ip saddr @deny4 update @stat_block4 { ip saddr counter }")
    deny.append("    ip saddr @deny4 counter name blocked drop")
    if stats:
        deny.append(f"    ip6 saddr @deny6 update @stat_block6 {{ ip6 saddr and {V6NET} counter }}")
    deny.append("    ip6 saddr @deny6 counter name blocked drop")
    # BLOCK_NETS_OPEN_PORTS="yes": before the open ports, so they are closed for them too
    if block_open_ports:
        lines += deny
    # Ports open worldwide (OPEN_TCP / OPEN_UDP)
    if open_tcp:
        lines.append(f"    tcp dport {{ {', '.join(open_tcp)} }} accept")
    if open_udp:
        lines.append(f"    udp dport {{ {', '.join(open_udp)} }} accept")
    if not block_open_ports:
        lines += deny
    # The country check: source in an allow set -> accept, everything else -> drop.
    # "counter name ..." adds to the named counters allowed/blocked (totals in the menu).
    # Counting in rules of their own: a full statistics set must never change the verdict.
    # "update @set { key counter }" adds the key if missing and counts the packet on it.
    if stats:
        lines.append("    ip saddr @allow4 update @stat_allow4 { ip saddr counter }")
    lines.append("    ip saddr @allow4 counter name allowed accept")
    if stats:
        lines.append(f"    ip6 saddr @allow6 update @stat_allow6 {{ ip6 saddr and {V6NET} counter }}")
    lines.append("    ip6 saddr @allow6 counter name allowed accept")
    # Whatever is left comes from a country that is not allowed
    if stats:
        lines.append("    meta nfproto ipv4 update @stat_block4 { ip saddr counter }")
        lines.append(f"    meta nfproto ipv6 update @stat_block6 {{ ip6 saddr and {V6NET} counter }}")
    lines += ["    counter name blocked drop", "  }"]
    return lines


def keep_ruleset(body_lines):
    """Daily reload: replaces only the chain, the allow sets and the blocked networks, so
    the statistics keep counting. "add" before "delete" makes the delete work even if the
    object is missing, e.g. the deny sets after an upgrade from a version without them."""
    return [
        f"add chain {TABLE} prerouting",
        f"delete chain {TABLE} prerouting",
        f"delete set {TABLE} allow4",
        f"delete set {TABLE} allow6",
        f"add set {TABLE} deny4 {{ type ipv4_addr; flags interval; }}",
        f"delete set {TABLE} deny4",
        f"add set {TABLE} deny6 {{ type ipv6_addr; flags interval; }}",
        f"delete set {TABLE} deny6",
        f"table {TABLE} {{",
        *body_lines,
        "}",
    ]


def new_ruleset(body_lines, stats_max):
    """First start, after a reboot or an older version: the whole table anew."""
    lines = [f"add table {TABLE}", f"delete table {TABLE}", f"table {TABLE} {{"]
    # Statistics sets: filled by the rules ("flags dynamic"); when "size" is reached,
    # new addresses are no longer added (they still count in the totals)
    if stats_max:
        for name, addr_type in (("allow4", "ipv4_addr"), ("block4", "ipv4_addr"),
                                ("allow6", "ipv6_addr"), ("block6", "ipv6_addr")):
            lines.append(f"  set stat_{name} {{ type {addr_type}; size {stats_max}; flags dynamic; }}")
    lines += ["  counter allowed { }", "  counter blocked { }", *body_lines, "}"]
    return lines


def loaded_stats_size():
    """Size of the loaded statistics sets, 0 if there are none."""
    # All four sets have the same size, so looking at one is enough
    out = nft("list", "set", *TABLE.split(), "stat_block4", check=False).stdout
    m = re.search(r"^\s*size (\d+)", out, re.M)
    return int(m.group(1)) if m else 0


def write(path, lines):
    """Writes lines to a file and returns its path."""
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    return path


# --- Main -------------------------------------------------------------------------------

def turn_off():
    """ENABLED is not "yes": remove the whole table (no error if it isn't loaded)."""
    nft("delete", "table", *TABLE.split(), check=False)
    if os.path.exists(STATS_SINCE):
        os.remove(STATS_SINCE)
    print("geowarden: blocking turned off")


def apply(conf, workdir):
    """Checks the config, builds the rules and loads them. workdir is a temporary
    directory for the .nft files."""
    # Validate all settings first, before anything is downloaded or loaded
    countries = set(words(conf, "COUNTRIES", r"[A-Za-z]{2}", "a two-letter country code"))
    countries = {c.lower() for c in countries}
    wan_if = words(conf, "WAN_IF", r"[\w.:@+*-]{1,15}", "an interface name") or default_route_ifaces()
    if not wan_if:
        raise Error(f"No public interface found - please set WAN_IF in {CONF}")
    open_tcp, open_udp = ports(conf, "OPEN_TCP"), ports(conf, "OPEN_UDP")
    stats_max = conf.get("STATS_MAX", "10000")  # older configurations have no STATS_MAX
    if not stats_max.isdigit():
        raise Error(f"STATS_MAX in {CONF} must be a number")
    stats_max = int(stats_max)
    deny = networks(conf, "BLOCK_NETS")
    block_open_ports = yes_no(conf, "BLOCK_NETS_OPEN_PORTS", "yes")

    # Geo data -> merged ranges -> nft element strings
    ranges = load_geo_data(countries)
    allow4 = nft_elements(merge(ranges[4]), 4)
    allow6 = nft_elements(merge(ranges[6]), 6)
    if countries and not allow4 and not allow6:
        raise Error("No IP ranges found for the selected countries - rules left unchanged")

    # Both variants are prepared; which one is loaded is decided below
    body_lines = body(allow4, allow6, deny[4], deny[6], block_open_ports,
                      wan_if, open_tcp, open_udp, stats_max > 0)
    keep = write(os.path.join(workdir, "keep.nft"), keep_ruleset(body_lines))
    new = write(os.path.join(workdir, "new.nft"), new_ruleset(body_lines, stats_max))

    # nft -f loads a file as one transaction: if anything in it fails, nothing changes.
    # So the small update can simply be tried, and the whole table is the fallback.
    # The size of a set cannot be changed, so a new STATS_MAX also means a new table.
    # Without the start time (after a reboot) the statistics start over as well.
    if not (loaded_stats_size() == stats_max and (nonempty(STATS_SINCE) or stats_max == 0)
            and nft("-f", keep, check=False).returncode == 0):
        nft("-f", new)
        # New table = empty statistics, so their start time is now
        if os.path.exists(STATS_SINCE):
            os.remove(STATS_SINCE)
        if stats_max:
            os.makedirs(os.path.dirname(STATS_SINCE), exist_ok=True)
            with open(STATS_SINCE, "w") as f:
                f.write(f"{int(time.time())}\n")

    blocked = len(deny[4]) + len(deny[6])
    print(f"geowarden: loaded {len(allow4)} IPv4 and {len(allow6)} IPv6 ranges "
          f"({len(countries)} countries, interface: {' '.join(wan_if)})"
          + (f", {blocked} blocked network{'s' if blocked != 1 else ''}" if blocked else ""))


def main():
    """Entry point for the timer, the service and the menu. Errors end with exit
    code 1 and a message; the rules stay as they were."""
    try:
        conf = read_conf()
        if conf.get("ENABLED", "no") != "yes":
            turn_off()
            return
        with tempfile.TemporaryDirectory() as workdir:
            apply(conf, workdir)
    except Error as e:
        sys.exit(f"geowarden: {e}")


if __name__ == "__main__":
    main()
