#!/bin/bash
# Loads the IP ranges of the allowed countries and sets the nftables table "inet geowarden".
# New connections on the public interfaces from any other address are dropped.
set -euo pipefail

CONF=/etc/geowarden.conf
[ -r "$CONF" ] || { echo "$CONF is missing" >&2; exit 1; }
. "$CONF"

if [ "${ENABLED:-no}" != "yes" ]; then
	nft delete table inet geowarden 2>/dev/null || true
	echo "geowarden: blocking turned off"
	exit 0
fi

# Without WAN_IF: interfaces of the default routes (IPv4 and IPv6)
if [ -z "${WAN_IF:-}" ]; then
	WAN_IF=$( { ip -4 -o route show default; ip -6 -o route show default; } \
		| grep -o 'dev [^ ]*' | cut -d' ' -f2 | sort -u | tr '\n' ' ')
fi
WAN_IF=$(echo $WAN_IF)
[ -n "$WAN_IF" ] || { echo "No public interface found - please set WAN_IF in $CONF" >&2; exit 1; }

# Geolocation data: "IP Geolocation by DB-IP" (https://db-ip.com), license CC BY 4.0.
# Published monthly; early in the month it may not be out yet, then use the previous month.
SRC="https://download.db-ip.com/free/dbip-country-lite"
CACHE=/var/cache/geowarden
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$CACHE"

DB=""
for m in "$(date +%Y-%m)" "$(date -d '-1 month' +%Y-%m)"; do
	if [ -s "$CACHE/dbip-$m.csv.gz" ]; then DB="$CACHE/dbip-$m.csv.gz"; break; fi
	if curl -fsS --retry 3 --max-time 300 "$SRC-$m.csv.gz" -o "$WORK/dl.csv.gz" \
		&& gzip -t "$WORK/dl.csv.gz" \
		&& [ "$(zcat "$WORK/dl.csv.gz" | wc -l)" -gt 100000 ]; then
		mv "$WORK/dl.csv.gz" "$CACHE/dbip-$m.csv.gz"
		DB="$CACHE/dbip-$m.csv.gz"
		find "$CACHE" -name 'dbip-*.csv.gz' ! -name "dbip-$m.csv.gz" -delete
		break
	fi
done
[ -n "$DB" ] || { echo "Download failed - rules left unchanged" >&2; exit 1; }

# CSV lines: start,end,COUNTRY -> nft range "start-end" (single address without "-",
# older nft versions reject "a-a")
: > "$WORK/all4"; : > "$WORK/all6"
zcat "$DB" | awk -F, -v list="${COUNTRIES^^}" -v out="$WORK/all" '
	BEGIN { n = split(list, c, " "); for (i = 1; i <= n; i++) ok[c[i]] = 1 }
	ok[$3] { print ($1 == $2 ? $1 : $1 "-" $2) > (out (index($1, ":") ? "6" : "4")) }'

n4=$(wc -l < "$WORK/all4"); n6=$(wc -l < "$WORK/all6")
if [ -n "${COUNTRIES// /}" ] && [ $((n4 + n6)) -eq 0 ]; then
	echo "No IP ranges found for the selected countries - rules left unchanged" >&2
	exit 1
fi

elements() { [ -s "$1" ] && { echo " elements = {"; paste -sd, "$1"; echo " }"; }; true; }
quoted() { local out="" i; for i in $1; do out+="${out:+, }\"$i\""; done; echo "$out"; }

{
	echo "add table inet geowarden"
	echo "delete table inet geowarden"
	echo "table inet geowarden {"
	echo "  set allow4 { type ipv4_addr; flags interval; auto-merge;"
	elements "$WORK/all4"
	echo "  }"
	echo "  set allow6 { type ipv6_addr; flags interval; auto-merge;"
	elements "$WORK/all6"
	echo "  }"
	echo "  counter blocked { }"
	echo "  chain prerouting {"
	# priority -150: after conntrack (-200), before DNAT e.g. by Docker (-100)
	echo "    type filter hook prerouting priority -150; policy accept;"
	echo "    iifname != { $(quoted "$WAN_IF") } accept"
	echo "    ct state established,related accept"
	[ -n "${OPEN_TCP// /}" ] && echo "    tcp dport { ${OPEN_TCP// /, } } accept"
	[ -n "${OPEN_UDP// /}" ] && echo "    udp dport { ${OPEN_UDP// /, } } accept"
	echo "    udp sport 67 udp dport 68 accept"
	echo "    ip6 saddr fe80::/10 accept"
	echo "    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept"
	echo "    ip saddr @allow4 accept"
	echo "    ip6 saddr @allow6 accept"
	echo "    counter name blocked drop"
	echo "  }"
	echo "}"
} > "$WORK/geowarden.nft"

nft -c -f "$WORK/geowarden.nft"
nft -f "$WORK/geowarden.nft"
echo "geowarden: loaded $n4 IPv4 and $n6 IPv6 ranges ($(wc -w <<< "$COUNTRIES") countries, interface: $WAN_IF)"
