#!/bin/sh
# Runs after the files are removed. $1 = "remove" (apt remove) or "purge" (apt purge,
# also after an earlier remove).
set -e

# The unit files are gone: let systemd forget them
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
fi

# Purge also deletes the configuration and the cached geo data
if [ "$1" = "purge" ]; then
	rm -f /etc/geowarden.conf /etc/geowarden.conf.tmp
	rm -rf /var/cache/geowarden
fi

exit 0
